# Copia este archivo como ".env" (en la misma carpeta que pom.xml) y rellénalo.
# El archivo ".env" está en .gitignore: NO se sube a GitHub.
# Spring Boot lo lee solo al arrancar el backend desde esta carpeta.

# MySQL
DB_USERNAME=root
DB_PASSWORD=pon_aqui_tu_clave_nueva_de_mysql

# Gmail (usa una "contraseña de aplicación" NUEVA, no la de tu cuenta)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=pon_aqui_la_contrasena_de_aplicacion

# Secreto para firmar los tokens (JWT). Mínimo 64 caracteres aleatorios.
# Genéralo en PowerShell:  -join ((48..57)+(97..102) | Get-Random -Count 128 | % {[char]$_})
JWT_SECRET=pon_aqui_el_secreto_generado

# IA de planes de estudio (Mistral)
MISTRAL_API_KEY=pon_aqui_tu_key_nueva

# Dominio público de Tailscale Funnel (sin "/" al final)
app.security.allowed-origins=https://TU-PC.TU-RED.ts.net
